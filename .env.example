# CrimsonHorizon environment variables
# Copy the values you need. Never commit real .env files (they are git-ignored).

# ---------------------------------------------------------------
# Frontend (Vite) — put these in frontend/.env.local
#   cp .env.example frontend/.env.local
# Only variables starting with VITE_ are exposed to the browser,
# so never put secrets here.
# ---------------------------------------------------------------

# Base URL of the backend API (no trailing slash).
# Local: http://localhost:8000
# Production: your Render URL, e.g. https://crimson-horizon-backend.onrender.com
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------
# Backend (FastAPI) — set as a shell environment variable or in
# the Render dashboard. The backend does not read .env files.
# ---------------------------------------------------------------

# Comma-separated list of frontend origins allowed by CORS.
# Use explicit origins; wildcard (*) is rejected. An empty value disables CORS access.
# Default when unset: http://localhost:5173
# Production example: https://crimson-horizon.pages.dev
CORS_ORIGINS=http://localhost:5173
