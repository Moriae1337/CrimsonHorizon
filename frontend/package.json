{
  "name": "crimson-horizon-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "format": "prettier .. --ignore-path ../.gitignore --ignore-path ../.prettierignore --write",
    "format:check": "prettier .. --ignore-path ../.gitignore --ignore-path ../.prettierignore --check",
    "test": "node --test tests/*.test.ts",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "ol": "^10.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.93.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  }
}
